---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  {
    name: '6502 Emulator',
    status: 'shipped',
    description:
      'A from-scratch MOS 6502 emulator in C++ with a debugger, memory-mapped console, and timer interrupts. Compiled to WebAssembly, with an assembler written in TypeScript, so you can write and run 6502 assembly right in the browser.',
    stack: ['C++', 'WebAssembly', 'TypeScript'],
    href: '/projects/6502',
    cta: 'Try the playground',
  },
];
---

<BaseLayout title="Projects" description="Things I've built — currently a 6502 emulator you can try in the browser.">
  <section class="wrap header-block">
    <p class="eyebrow">lab notebook</p>
    <h1>Projects</h1>
    <p class="lede">
      Things I've built to understand how they work. Right now that's a 6502
      CPU emulator, and you can run it in your browser.
    </p>
  </section>

  <section class="wrap">
    <div class="grid">
    {
      projects.map((project) => (
        <article class="card">
          <div class="card-head">
            <h2>{project.name}</h2>
            <span class:list={['status', 'mono', project.status]}>{project.status}</span>
          </div>
          <p class="desc">{project.description}</p>
          {project.href && (
            <a class="link try" href={project.href}>
              {project.cta} →
            </a>
          )}
          <div class="stack">
            {project.stack.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </div>
        </article>
      ))
    }
    </div>
  </section>
</BaseLayout>

<style>
  .header-block {
    padding-top: 3rem;
    padding-bottom: 1.5rem;
    max-width: var(--measure);
  }

  h1 {
    font-size: 2rem;
    margin: 0.3rem 0 0.8rem;
  }

  .lede {
    color: var(--ink-soft);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-bottom: 4rem;
  }

  .card {
    background: var(--bg);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .card-head h2 {
    font-size: 1.05rem;
  }

  .status {
    font-size: 0.7rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .status.active {
    color: var(--moss);
  }

  .desc {
    color: var(--ink-soft);
    font-size: 0.92rem;
    flex-grow: 1;
  }

  .try {
    font-size: 0.92rem;
    align-self: flex-start;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
</style>
