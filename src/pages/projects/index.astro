---
import BaseLayout from '../../layouts/BaseLayout.astro';

// One entry per project. `specimen` is a short, real excerpt shown beside the
// copy: each code line is a list of [class, text] spans (lb, op, ar, cm).
type Span = [string, string];

// A line of 6502 assembly: label, mnemonic, operand, comment.
const asm = (label: string, op: string, arg: string, note = ''): Span[] => [
  ['lb', label.padEnd(7)],
  ['op', op.padEnd(6)],
  ['ar', arg],
  ...(note ? [['cm', `  ; ${note}`] as Span] : []),
];

// A line of `thompson -trace` output: the character read, then the state set.
const trace = (read: string, set: string): Span[] =>
  read
    ? [['op', 'read '], ['lb', read.padEnd(6)], ['ar', set]]
    : [['op', 'start'.padEnd(11)], ['ar', set]];

const projects = [
  {
    name: '6502 Emulator',
    status: 'Shipped',
    summary:
      'A MOS 6502 CPU written from scratch in C++, with a debugger, a memory-mapped console and timer interrupts. Compiled to WebAssembly and paired with an assembler in TypeScript, it runs entirely in your browser.',
    stack: ['C++', 'WebAssembly', 'TypeScript'],
    href: '/projects/6502',
    cta: 'Open the playground',
    specimen: {
      title: 'print_string.asm',
      code: [
        asm('', 'LDX', '#0'),
        asm('LOOP:', 'LDA', 'MSG,X'),
        asm('', 'BEQ', 'DONE', 'end of string'),
        asm('', 'STA', '$FF00', 'write to console'),
        asm('', 'INX', ''),
        asm('', 'JMP', 'LOOP'),
        asm('DONE:', 'JMP', 'DONE', 'halt'),
        asm('MSG:', '.byte', '"6502", 0'),
      ],
      outputTitle: 'console',
      output: '6502',
      footer: 'Halted at $090E',
    },
  },
  {
    name: "Thompson's NFA",
    status: 'Shipped',
    summary:
      'A regex engine in Go, built the way Ken Thompson described in 1968: compile the pattern to an NFA, then follow every path at once, so matching stays linear in the input. Compiled to WebAssembly, it animates its own state machine reading your string.',
    stack: ['Go', 'WebAssembly', 'JavaScript'],
    href: '/projects/thompson',
    cta: 'Watch it run',
    specimen: {
      title: "thompson -trace '(a|b)*abb' aabb",
      code: [
        trace('', '{0 1 2 3 4}'),
        trace('"a"', '{0 1 2 3 4 5}'),
        trace('"a"', '{0 1 2 3 4 5}'),
        trace('"b"', '{0 1 2 3 4 6}'),
        trace('"b"', '{0 1 2 3 4 7}'),
      ],
      outputTitle: 'result',
      output: 'match',
      footer: 'State 7 accepts',
    },
  },
];
---

<BaseLayout title="Projects" description="Things I've built: a 6502 emulator and a Thompson NFA regex engine, both running in your browser.">
  <div class="page">
    <header class="intro">
      <h1>Projects</h1>
      <p class="lede">Things I've built to understand how they work.</p>
    </header>

    <ol class="list">
      {
        projects.map((p) => (
          <li class="project">
            <div class="copy">
              <div class="title-row">
                <h2><a href={p.href}>{p.name}</a></h2>
                <span class="status">{p.status}</span>
              </div>
              <p class="summary">{p.summary}</p>
              <p class="stack mono">{p.stack.join(', ')}</p>
              <a class="cta" href={p.href}>{p.cta}</a>
            </div>

            <a class="specimen" href={p.href} tabindex="-1" aria-hidden="true">
              <div class="pane code">
                <div class="bar mono">{p.specimen.title}</div>
                <pre class="mono">{p.specimen.code.map((line) => (
                  <span class="ln">{line.map(([cls, text]) => <span class={cls}>{text}</span>)}{'\n'}</span>
                ))}</pre>
              </div>
              <div class="pane out">
                <div class="bar mono"><span>{p.specimen.outputTitle}</span><span>{p.specimen.footer}</span></div>
                <pre class="mono result">{p.specimen.output}<span class="caret"></span></pre>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  .intro {
    padding: 3.5rem 0 2.5rem;
  }

  h1 {
    font-size: 2rem;
    margin: 0 0 0.6rem;
  }

  .lede {
    color: var(--ink-soft);
    margin: 0;
    max-width: 36rem;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 3rem;
    align-items: center;
    padding: 2.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  /* copy */
  .title-row {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 0.9rem;
  }

  h2 {
    font-size: 1.6rem;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent-ink);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .status::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--moss);
  }

  .summary {
    color: var(--ink-soft);
    max-width: 34rem;
    margin: 0 0 1rem;
  }

  .stack {
    font-size: 0.8rem;
    color: var(--ink-faint);
    margin: 0 0 1.5rem;
  }

  .cta {
    display: inline-block;
    padding: 0.55rem 1.05rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: filter 0.15s ease;
  }

  .cta:hover {
    filter: brightness(1.12);
  }

  /* specimen: an excerpt of the real thing, not a card */
  .specimen {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .specimen:hover {
    border-color: var(--accent);
  }

  .pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pane + .pane {
    border-top: 1px solid var(--line);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 1rem;
    font-size: 0.72rem;
    color: var(--ink-faint);
    border-bottom: 1px solid var(--line);
  }

  pre {
    margin: 0;
    padding: 0.9rem 1rem;
    font-size: 0.8rem;
    line-height: 1.7;
    overflow: hidden;
    white-space: pre;
  }

  .lb {
    color: var(--ink-soft);
  }

  .op {
    color: var(--accent-ink);
  }

  .cm {
    color: var(--ink-faint);
  }

  .result {
    font-size: 1.05rem;
  }

  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.1em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 52rem) {
    .project {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 34rem) {
    pre {
      font-size: 0.72rem;
    }
  }
</style>
