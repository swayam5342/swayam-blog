---
const { pathname } = Astro.url;
import Search from '../components/Search.astro';
import ThemePicker from '../components/ThemePicker.astro';

const navItems = [
  { href: '/blog', label: 'Blog' },
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Swayam — home">
      <span class="mark" aria-hidden="true">S</span>
      <span class="brand-name">swayam</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        navItems.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
      <a href="https://github.com/swayam5342" class="nav-link">GitHub</a>

      <Search />
      <ThemePicker />
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
  }

  .mark {
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    border-radius: var(--radius);
  }

  .brand-name {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--ink-soft);
    position: relative;
    padding-bottom: 0.2rem;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.active {
    color: var(--ink);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
  }

  @media (max-width: 480px) {
    .brand-name {
      display: none;
    }
    .nav {
      gap: 1rem;
    }
  }
</style>
