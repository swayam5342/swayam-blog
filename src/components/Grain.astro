---
// Embeds the Grain sandbox in an isolated iframe. Its panel follows the site
// theme: light or dark, picked from the brightness of --bg.
interface Props {
  src?: string;         // URL of the sandbox; defaults to the copy served from /grain/
  height?: string;      // any CSS length; defaults to a comfortable viewport-relative height
  title?: string;
}
const { src = "/grain/", height = "min(80vh, 720px)", title = "Grain, a falling-sand sandbox" } = Astro.props;
---
<div class="grain-embed" style={`--grain-h:${height}`}>
  <iframe src={src} title={title} loading="lazy" allow="fullscreen"></iframe>
</div>

<script>
  // --bg is read directly because body's background-color is mid-transition
  // right after a theme switch.
  function siteIsDark() {
    const bg = getComputedStyle(document.documentElement).getPropertyValue("--bg").trim();
    let hex = bg.replace("#", "");
    if (hex.length === 3) hex = [...hex].map((c) => c + c).join("");
    if (!/^[0-9a-f]{6}$/i.test(hex)) return true;
    const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16));
    return 0.2126 * r + 0.7152 * g + 0.0722 * b < 128;
  }

  function sync(frame: HTMLIFrameElement) {
    try {
      const root = frame.contentDocument?.documentElement;
      if (root) root.dataset.theme = siteIsDark() ? "dark" : "light";
    } catch {
      // Cross-origin src: the page keeps its own theme.
    }
  }

  const frames = document.querySelectorAll<HTMLIFrameElement>(".grain-embed iframe");
  frames.forEach((f) => {
    f.addEventListener("load", () => sync(f));
    sync(f);
  });
  new MutationObserver(() => frames.forEach(sync)).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>

<style>
  .grain-embed {
    width: 100%;
    height: var(--grain-h);
    min-height: 420px;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--line, rgba(127, 127, 127, 0.25));
  }
  .grain-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
