---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Building things, learning, and writing about it.',
} = Astro.props;

const pageTitle = title === 'Home' ? 'Swayam' : `${title} · Swayam`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />

    <title>{pageTitle}</title>

    <script is:inline>
      (function () {
        var THEME_IDS = [
          'dark', 'light', 'ayu-light', 'catppuccin-latte', 'github-light',
          'tokyo-night-storm', 'catppuccin-mocha', 'gruvbox-dark', 'nord', 'solarized',
        ];
        var DARK_THEMES = ['dark', 'tokyo-night-storm', 'catppuccin-mocha', 'gruvbox-dark', 'nord', 'solarized'];
        var LIGHT_THEMES = ['light', 'ayu-light', 'catppuccin-latte', 'github-light'];

        var saved = localStorage.getItem('theme');
        var theme;
        if (saved && THEME_IDS.indexOf(saved) !== -1) {
          theme = saved;
        } else {
          var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          var pool = prefersLight ? LIGHT_THEMES : DARK_THEMES;
          theme = pool[Math.floor(Math.random() * pool.length)];
          localStorage.setItem('theme', theme);
        }

        if (theme !== 'dark') {
          document.documentElement.setAttribute('data-theme', theme);
        }
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
